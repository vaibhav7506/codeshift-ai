<?xml version="1.0"?>
<configuration>
  <system.web>
    <authentication mode="Forms" />
    <sessionState mode="InProc" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding />
    </bindings>
  </system.serviceModel>
</configuration>
