# Optional for the web analyzer. Public repository analysis works without a
# token, but authenticated requests receive a higher GitHub API rate limit.
# The CLI PR flow reads GITHUB_TOKEN from its shell and requires repository
# contents and pull request write access. Never commit a real token.
GITHUB_TOKEN=

# CLI-only BYOK variables. Set these in your shell before running the CLI.
# Never prefix provider keys with NEXT_PUBLIC_ or commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Control-plane runtime. Development uses in-memory adapters. Staging and
# production fail readiness unless durable services and strong secrets exist.
CODESHIFT_ENV=development
CODESHIFT_PUBLIC_URL=http://localhost:3000
DATABASE_URL=
CODESHIFT_ENCRYPTION_KEY=
CODESHIFT_IDENTITY_SECRET=
GITHUB_WEBHOOK_SECRET=
CODESHIFT_LOG_RETENTION_DAYS=30
CODESHIFT_AUDIT_RETENTION_DAYS=365
CODESHIFT_OBJECT_LIFECYCLE_DAYS=30
