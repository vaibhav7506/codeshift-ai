{
  "name": "codeshift-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A controlled, review-first JavaScript to TypeScript migration workspace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format:check": "git diff --check",
    "deployment:validate": "node scripts/validate-deployment.mjs",
    "load:test": "node scripts/load-test.mjs",
    "package:cli": "npm pack --workspace=@codeshift/cli --dry-run",
    "package:runner": "npm pack --workspace=@codeshift/runner --dry-run",
    "license:report": "node scripts/license-report.mjs",
    "security:secrets": "node --test scripts/secret-scan.test.mjs && node scripts/secret-scan.mjs"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "nanoid": "3.3.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
